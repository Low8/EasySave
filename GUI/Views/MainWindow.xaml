<Window x:Class="GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding MenuTitleText}" Height="760" Width="1200"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="CardBrush" Color="White" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Jobs" FontSize="18" FontWeight="SemiBold" Margin="4,2,4,10" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Jobs}"
                         SelectedItem="{Binding SelectedJob}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="10" Margin="0,0,0,10">
                                <Grid Width="390" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left" />
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Background="#EEF2FF" Padding="8,2">
                                            <TextBlock Text="{Binding Status}" Foreground="#4338CA" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding SourceDir}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="{Binding TargetDir}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="3" Text="{Binding Type}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                    <ProgressBar Grid.Row="4" Value="{Binding Progress}" Maximum="100" Height="10" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="5" Text="{Binding ProgressText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="6" Text="{Binding RemainingFilesText}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="7" Text="{Binding RemainingSizeText}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="8" Text="{Binding CurrentSourceText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="9" Text="{Binding CurrentDestText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <DockPanel Grid.Row="10" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding LastUpdateText}" Foreground="{StaticResource MutedTextBrush}" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding IsActiveText}" DockPanel.Dock="Right" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9CA3AF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding TabActionsText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" Margin="0,0,0,14" FontWeight="SemiBold" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding MenuRunText}" Command="{Binding RunSelectedCommand}" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding MenuRunAllText}" Command="{Binding RunAllCommand}" />
                            <Button Style="{StaticResource DangerButtonStyle}" Content="{Binding MenuDeleteText}" Command="{Binding RemoveJobCommand}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding MenuCreateText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptNameText}" />
                            <TextBox Text="{Binding NewJobName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptSourceText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewSourceDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="..." Command="{Binding BrowseNewSourceCommand}" Margin="0" Padding="0" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptTargetText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewTargetDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="..." Command="{Binding BrowseNewTargetCommand}" Margin="0" Padding="0" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptTypeText}" />
                            <ComboBox ItemsSource="{Binding BackupTypes}" SelectedItem="{Binding NewJobType}" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding MenuCreateText}" Command="{Binding AddJobCommand}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding MenuEditText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptNameText}" />
                            <TextBox Text="{Binding EditJobName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptSourceText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditSourceDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="..." Command="{Binding BrowseEditSourceCommand}" Margin="0" Padding="0" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptTargetText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditTargetDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="..." Command="{Binding BrowseEditTargetCommand}" Margin="0" Padding="0" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding PromptTypeText}" />
                            <ComboBox ItemsSource="{Binding BackupTypes}" SelectedItem="{Binding EditJobType}" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding MenuEditText}" Command="{Binding UpdateJobCommand}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding MenuSettingsText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Settings.StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding SettingsCurrentFormatText}" />
                            <ComboBox ItemsSource="{Binding Settings.LogFormats}" SelectedItem="{Binding Settings.LogFormat}" />

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding Settings.SettingsLanguageText}" />
                            <ComboBox ItemsSource="{Binding Settings.LanguageOptions}" SelectedItem="{Binding Settings.SelectedLanguage}" />

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding Settings.SettingsBusinessSoftText}" />
                            <ListBox ItemsSource="{Binding Settings.BusinessSoftwareNames}"
                                     SelectedItem="{Binding Settings.SelectedBusinessSoftwareName}"
                                     Height="120"
                                     Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.NewBusinessSoftwareName, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Settings.ButtonAddText}" Command="{Binding Settings.AddBusinessSoftwareCommand}" Margin="0" />
                                <Button Grid.Column="4" Style="{StaticResource DangerButtonStyle}" Content="{Binding Settings.ButtonRemoveText}" Command="{Binding Settings.RemoveBusinessSoftwareCommand}" Margin="0" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding Settings.SettingsEncryptedExtText}" />
                            <ListBox ItemsSource="{Binding Settings.EncryptedExtensions}"
                                     SelectedItem="{Binding Settings.SelectedEncryptedExtension}"
                                     Height="120"
                                     Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.NewEncryptedExtension, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Settings.ButtonAddText}" Command="{Binding Settings.AddEncryptedExtensionCommand}" Margin="0" />
                                <Button Grid.Column="4" Style="{StaticResource DangerButtonStyle}" Content="{Binding Settings.ButtonRemoveText}" Command="{Binding Settings.RemoveEncryptedExtensionCommand}" Margin="0" />
                            </Grid>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Settings.ButtonApplyText}" Command="{Binding Settings.SaveCommand}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
