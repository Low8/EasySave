<Window x:Class="GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:EasySave.GUI.Helpers"
        Title="{Binding MenuTitleText}" Height="780" Width="1240"
        Background="#F0F4F8"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Brush.Primary" Color="#0F766E" />
        <SolidColorBrush x:Key="Brush.PrimaryDark" Color="#0D9488" />
        <SolidColorBrush x:Key="Brush.Danger" Color="#B91C1C" />
        <SolidColorBrush x:Key="Brush.DangerHover" Color="#991B1B" />
        <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Brush.Muted" Color="#64748B" />
        <SolidColorBrush x:Key="Brush.Text" Color="#0F172A" />
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#CCFBF1" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="Text.Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PrimaryDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Secondary" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.IconBrowse" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Content" Value="···" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Margin="0,0,4,0" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0" Background="Transparent">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox" x:Key="List.Jobs">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBd" Background="Transparent" CornerRadius="8" Padding="4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E0F2FE" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#F1F5F9" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemBd" Property="Background" Value="#CFFAFE" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="380" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="3*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Panneau liste des jobs -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" CornerRadius="12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="4,0,4,12" Text="{Binding MenuListText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <ListBox Grid.Row="1"
                         Style="{StaticResource List.Jobs}"
                         ItemsSource="{Binding Jobs}"
                         SelectedItem="{Binding SelectedJob}"
                         SelectionMode="Extended"
                         helpers:ListBoxSelectedItemsBehavior.SelectedItems="{Binding SelectedJobs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Background="#FAFCFE" Padding="12" Margin="0,0,0,6">
                                <Grid MinWidth="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" DockPanel.Dock="Left" />
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Brush.AccentSoft}" CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#115E59" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding SourceDir}" Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="{Binding TargetDir}" Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="3" Text="{Binding Type}" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,6,0,0" />
                                    <ProgressBar Grid.Row="4" Value="{Binding Progress}" Maximum="100" Height="8" Margin="0,8,0,4" Foreground="{StaticResource Brush.Primary}" Background="#E2E8F0" />
                                    <TextBlock Grid.Row="5" Text="{Binding ProgressText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" />
                                    <TextBlock Grid.Row="6" Text="{Binding RemainingFilesText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" />
                                    <TextBlock Grid.Row="7" Text="{Binding RemainingSizeText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" />
                                    <TextBlock Grid.Row="8" Text="{Binding CurrentSourceText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="9" Text="{Binding CurrentDestText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" TextWrapping="Wrap" />
                                    <DockPanel Grid.Row="10" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding LastUpdateText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding IsActiveText}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Panneau onglets -->
        <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" CornerRadius="12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="4,8,8,8">
            <TabControl>
                <TabItem Header="{Binding TabActionsText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
                        <StackPanel MaxWidth="520">
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>

                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding MenuRunText}" Command="{Binding RunSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding MenuRunAllText}" Command="{Binding RunAllCommand}" />
                            <Button Style="{StaticResource Btn.Danger}" Content="{Binding MenuDeleteText}" Command="{Binding RemoveJobCommand}" />

                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding MenuSelectedJobsText}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding MenuPauseText}" Command="{Binding PauseSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding MenuResumeText}" Command="{Binding ResumeSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding MenuStopText}" Command="{Binding StopSelectedCommand}" />

                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding MenuAllJobsText}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding MenuPauseAllText}" Command="{Binding PauseAllCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding MenuResumeAllText}" Command="{Binding ResumeAllCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding MenuStopAllText}" Command="{Binding StopAllCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding MenuCreateText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
                        <StackPanel MaxWidth="520">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptNameText}" />
                            <TextBox Text="{Binding NewJobName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptSourceText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewSourceDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.IconBrowse}" Command="{Binding BrowseNewSourceCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptTargetText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewTargetDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.IconBrowse}" Command="{Binding BrowseNewTargetCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptTypeText}" />
                            <ComboBox ItemsSource="{Binding BackupTypes}" SelectedItem="{Binding NewJobType}" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding MenuCreateText}" Command="{Binding AddJobCommand}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding MenuEditText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
                        <StackPanel MaxWidth="520">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptNameText}" />
                            <TextBox Text="{Binding EditJobName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptSourceText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditSourceDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.IconBrowse}" Command="{Binding BrowseEditSourceCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptTargetText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditTargetDir, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.IconBrowse}" Command="{Binding BrowseEditTargetCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding PromptTypeText}" />
                            <ComboBox ItemsSource="{Binding BackupTypes}" SelectedItem="{Binding EditJobType}" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding MenuEditText}" Command="{Binding UpdateJobCommand}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding MenuSettingsText}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
                        <StackPanel MaxWidth="560">
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding Settings.StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding SettingsCurrentFormatText}" />
                            <ComboBox ItemsSource="{Binding Settings.LogFormats}" SelectedItem="{Binding Settings.LogFormat}" />

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Settings.SettingsLogTargetText}" />
                            <ComboBox ItemsSource="{Binding Settings.LogTargetOptions}"
                                      SelectedValue="{Binding Settings.LogTarget}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key" />

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Settings.SettingsLanguageText}" />
                            <ComboBox ItemsSource="{Binding Settings.LanguageOptions}" SelectedItem="{Binding Settings.SelectedLanguage}" />

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Settings.SettingsBusinessSoftText}" />
                            <ListBox ItemsSource="{Binding Settings.BusinessSoftwareNames}"
                                     SelectedItem="{Binding Settings.SelectedBusinessSoftwareName}"
                                     Height="110" Margin="0,0,0,8" BorderBrush="#CBD5E1" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.NewBusinessSoftwareName, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="{Binding Settings.ButtonAddText}" Command="{Binding Settings.AddBusinessSoftwareCommand}" Margin="0" Padding="12,8" />
                                <Button Grid.Column="4" Style="{StaticResource Btn.Danger}" Content="{Binding Settings.ButtonRemoveText}" Command="{Binding Settings.RemoveBusinessSoftwareCommand}" Margin="0" Padding="12,8" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Settings.SettingsEncryptedExtText}" />
                            <ListBox ItemsSource="{Binding Settings.EncryptedExtensions}"
                                     SelectedItem="{Binding Settings.SelectedEncryptedExtension}"
                                     Height="110" Margin="0,0,0,8" BorderBrush="#CBD5E1" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.NewEncryptedExtension, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="{Binding Settings.ButtonAddText}" Command="{Binding Settings.AddEncryptedExtensionCommand}" Margin="0" Padding="12,8" />
                                <Button Grid.Column="4" Style="{StaticResource Btn.Danger}" Content="{Binding Settings.ButtonRemoveText}" Command="{Binding Settings.RemoveEncryptedExtensionCommand}" Margin="0" Padding="12,8" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Settings.SettingsPriorityExtText}" />
                            <ListBox ItemsSource="{Binding Settings.PriorityExtensions}"
                                     SelectedItem="{Binding Settings.SelectedPriorityExtension}"
                                     Height="110" Margin="0,0,0,8" BorderBrush="#CBD5E1" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.NewPriorityExtension, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="{Binding Settings.ButtonAddText}" Command="{Binding Settings.AddPriorityExtensionCommand}" Margin="0" Padding="12,8" />
                                <Button Grid.Column="4" Style="{StaticResource Btn.Danger}" Content="{Binding Settings.ButtonRemoveText}" Command="{Binding Settings.RemovePriorityExtensionCommand}" Margin="0" Padding="12,8" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Settings.SettingsMaxParallelKbText}" />
                            <TextBox Text="{Binding Settings.MaxFileSizeForParallelTransferKb, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />

                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding Settings.ButtonApplyText}" Command="{Binding Settings.SaveCommand}" Margin="0,20,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
